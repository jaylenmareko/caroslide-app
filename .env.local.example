NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Real carousel generation (src/lib/generation/) -- added 2026-07-20
ANTHROPIC_API_KEY=sk-ant-your-key
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-browser-rendering-scoped-token
# Real web research for captions.ts/images.ts -- added 2026-07-20 (later same night), replaces
# Anthropic's web_search tool after it was found to trigger a safety-classifier refusal
TAVILY_API_KEY=tvly-your-key
# Primary photo source for images.ts -- added 2026-07-21. Tavily's own image search (used as a
# fallback tier) was found to return mostly stock-photo-marketplace previews for generic aesthetic
# photo briefs; Pexels is a curated free-to-use library built for exactly this, no attribution
# required. Get a free key at pexels.com/api.
PEXELS_API_KEY=your-pexels-api-key
