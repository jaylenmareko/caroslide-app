NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Real carousel generation (src/lib/generation/) -- added 2026-07-20
ANTHROPIC_API_KEY=sk-ant-your-key
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-browser-rendering-scoped-token
# Real web research for captions.ts/images.ts -- added 2026-07-20 (later same night), replaces
# Anthropic's web_search tool after it was found to trigger a safety-classifier refusal
TAVILY_API_KEY=tvly-your-key
# Primary photo source for images.ts -- added 2026-07-21. Tavily's own image search (used as a
# fallback tier) was found to return mostly stock-photo-marketplace previews for generic aesthetic
# photo briefs; Pexels is a curated free-to-use library built for exactly this, no attribution
# required. Get a free key at pexels.com/api.
PEXELS_API_KEY=your-pexels-api-key

# Billing (Stripe) -- added 2026-07-26. Products/prices are separate Products (one per tier/pack,
# per Stripe's own guidance -- never share a Product across tiers or line items become indistinguishable).
# 2026-07-27: Unlimited plan dropped (unbounded cost exposure) in favor of 2 capped tiers + one-time
# carousel packs for overage.
STRIPE_SECRET_KEY=sk_test_your-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
STRIPE_PRICE_STARTER=price_your-starter-price-id
STRIPE_PRICE_PRO=price_your-pro-price-id
STRIPE_PRICE_PACK_5=price_your-5-pack-price-id
STRIPE_PRICE_PACK_15=price_your-15-pack-price-id
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
# Service-role Supabase client (new sb_secret_ format) -- ONLY for the Stripe webhook, which has no
# user session to satisfy RLS's auth.uid() check. Never expose this to the browser.
SUPABASE_SECRET_KEY=sb_secret_your-key
