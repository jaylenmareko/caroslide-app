# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# QA screenshots
/artifacts/

# throwaway design mockups (design.md is the real spec, this folder is scratch)
/design/mocks/

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# generated from the real .html templates by scripts/generate-templates.mjs (runs before dev/build)
src/backend/lib/generation/templates/index.generated.ts
# generated from reference/*.md by scripts/generate-reference.mjs (runs before dev/build)
src/backend/lib/generation/referenceDocs.generated.ts

# git worktrees for isolated feature work
.worktrees/
