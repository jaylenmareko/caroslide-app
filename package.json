{
  "name": "caroslide-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:templates": "node scripts/generate-templates.mjs",
    "generate:reference": "node scripts/generate-reference.mjs",
    "generate:all": "npm run generate:templates && npm run generate:reference",
    "build": "npm run generate:all && next build",
    "dev": "npm run generate:all && next dev",
    "start": "next start",
    "lint": "eslint",
    "preview": "npm run generate:all && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run generate:all && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "npm run generate:all && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "image-size": "^2.0.2",
    "jszip": "^3.10.1",
    "next": "^16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "typescript": "^5",
    "wrangler": "^4.114.0"
  }
}
