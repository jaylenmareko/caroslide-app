{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "caroslide-app",
	"account_id": "4f2787f250e16d9e861d68fd74147cd3",
	"routes": [
		{ "pattern": "caroslide.com", "custom_domain": true }
	],
	"compatibility_date": "2026-07-26",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "caroslide-app"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	// Producer side only -- createCarousel enqueues a message here instead of running the real
	// generation pipeline inline. ctx.waitUntil() (tried first, 2026-07-31) only buys 30s past the
	// response before Cloudflare kills whatever's still running -- nowhere near enough for a real
	// 2-3 minute generation. A Queue consumer is its own real Worker invocation with the normal
	// full time budget, not bound by that 30s post-response cap. See workers/carousel-consumer/
	// for the actual consumer that does the work.
	"queues": {
		"producers": [
			{ "queue": "caroslide-carousel-generation", "binding": "CAROUSEL_QUEUE" }
		]
	},
	// Cross-script binding (2026-08-01) -- this app's own Server Actions (actions.ts's createCarousel
	// and editSlide) make real Claude calls directly (classifyAngle/classifyColors, chat-edit
	// classification/rewrites), spending from the exact same account-wide Anthropic per-minute
	// budget the Queue consumer's initial-generation calls do. The AnthropicRateLimiter Durable
	// Object class itself is only ever DEFINED in workers/carousel-consumer (see that Worker's own
	// wrangler.jsonc + migration) -- script_name here points this binding at that same real running
	// instance instead of standing up a second, independent (and wrong) budget just for this Worker.
	"durable_objects": {
		"bindings": [
			{ "name": "ANTHROPIC_LIMITER", "class_name": "AnthropicRateLimiter", "script_name": "caroslide-carousel-consumer" }
		]
	}
}